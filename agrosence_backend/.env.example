# ===== AgroSence backend - copy to .env (never commit .env) =====

# --- Server ---
NODE_ENV=development            # production on Render
PORT=5000                       # Render sets this automatically
TRUST_PROXY=1                   # number of proxies in front (Render = 1). Wrong value => rate limits/lockouts key on the wrong IP (see README)

# --- Database (MongoDB Atlas) ---
MONGO_URI=                      # mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_MAX_POOL=10               # connection pool size (keep small on Atlas free tier)

# --- Auth ---
JWT_SECRET=                     # REQUIRED in production, 32+ random chars (openssl rand -hex 48)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5            # account lock after N failures
LOCK_MINUTES=15
MAX_LOGIN_ATTEMPTS_ACCOUNT=20   # failures across all IPs that trigger a 1-minute per-account cooldown

# --- First admin (created on startup only if no admin exists; idempotent) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=                 # 8+ chars with a letter and a number; change it after first login
ADMIN_NAME=AgroSence Admin
ADMIN_MOBILE=9000000000

# --- CORS (comma separated; supports one-label wildcards like https://*.vercel.app) ---
CORS_ORIGINS=                   # e.g. https://agrosence.vercel.app,https://agrosence-admin.vercel.app
CORS_ALLOW_LOCALHOST=           # defaults to true in development and false in production (NODE_ENV=production or RENDER=true); set explicitly to override
# WARNING: wildcard origins (https://*.vercel.app) match EVERY project on that host, including other people's.
# Prefer exact origins in production; only use a wildcard if you accept that any *.vercel.app site can call the API with a user's token.

# --- Image storage (Cloudinary). Uploads return 503 when not set ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# or a single variable: CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>

# --- AI integrations (503 when not set) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
PLANT_ID_API_KEY=

# --- Email (OTP, support, contact notifications) ---
# Option A (recommended on Render free tier, which blocks SMTP ports): Resend HTTPS API
RESEND_API_KEY=
# Option B: SMTP (e.g. Gmail with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                      # e.g. "AgroSence" <no-reply@yourdomain>; defaults to SMTP_USER
MAIL_TO=                        # inbox that receives contact/support messages

# --- Keep-alive (optional in-process self ping every N minutes) ---
SELF_PING_URL=                  # e.g. https://agrosence-api.onrender.com (Render sets RENDER_EXTERNAL_URL itself)
SELF_PING_MINUTES=10

# --- Email over HTTPS (Render free tier blocks SMTP). Pick ONE: ---
# Brevo: free 300/day, verify a single sender address (no domain needed). MAIL_FROM must be that verified sender.
BREVO_API_KEY=
# Resend: needs a verified domain to email arbitrary users.
# RESEND_API_KEY=
